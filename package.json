{
  "name": "pictures-writers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build-webpack": "next build --webpack",
    "build:production": "prisma generate && prisma migrate deploy && next build",
    "build:agent": "node scripts/build-agent.mjs",
    "build:analyze": "cross-env ANALYZE=true next build",
    "bundle:analyze": "next experimental-analyze --output",
    "bundle:budget": "tsx scripts/bundle-budget.ts",
    "bundle:baseline": "tsx scripts/bundle-budget.ts --write-baseline",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:doc-citations": "node scripts/check-doc-citations.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:db:up": "docker compose up -d db",
    "test:db:down": "docker compose down",
    "test:db:reset": "docker compose down -v && docker compose up -d db",
    "dev:db:up": "docker compose -p pictures-writers-dev -f docker-compose.dev.yml up -d",
    "dev:db:down": "docker compose -p pictures-writers-dev -f docker-compose.dev.yml down",
    "dev:db:reset": "docker compose -p pictures-writers-dev -f docker-compose.dev.yml down -v && docker compose -p pictures-writers-dev -f docker-compose.dev.yml up -d",
    "dev:db:psql": "docker exec -i pictures-writers-dev-db psql -U postgres -d pictures_writers_dev",
    "agent:env": "node scripts/setup-agent-env.mjs",
    "agent:seed": "node --env-file=.env.agent --conditions=react-server --import tsx scripts/seed-agent.ts",
    "agent:db:psql": "docker exec -i pictures-writers-dev-db psql -U postgres -d pictures_writers_agent",
    "dev:agent": "node scripts/dev-agent.mjs",
    "media:backfill-metadata": "tsx --conditions=react-server scripts/backfill-media-metadata.ts",
    "media:backfill-renditions": "tsx --conditions=react-server scripts/backfill-media-renditions.ts",
    "media:repair-checksums": "tsx --conditions=react-server scripts/repair-media-checksums.ts",
    "media:repair-checksums:dry-run": "tsx --conditions=react-server scripts/repair-media-checksums.ts --dry-run",
    "media:audit": "tsx --conditions=react-server scripts/audit-media.ts",
    "media:rehome": "tsx --conditions=react-server scripts/rehome-media.ts",
    "media:purge": "tsx --conditions=react-server scripts/purge-media.ts",
    "media:sweep-addresses": "tsx --conditions=react-server scripts/sweep-media-addresses.ts",
    "media:sweep-addresses:dry-run": "tsx --conditions=react-server scripts/sweep-media-addresses.ts --dry-run",
    "media:relink-content": "tsx --conditions=react-server scripts/relink-media-content.ts",
    "media:relink-content:dry-run": "tsx --conditions=react-server scripts/relink-media-content.ts --dry-run",
    "site-regions:migrate-puck-data": "tsx --conditions=react-server scripts/migrate-site-region-puck-data.ts",
    "site-regions:migrate-puck-data:dry-run": "tsx --conditions=react-server scripts/migrate-site-region-puck-data.ts --dry-run",
    "puck:migrate-size-spacing": "tsx --conditions=react-server scripts/migrate-puck-size-spacing.ts",
    "puck:migrate-size-spacing:dry-run": "tsx --conditions=react-server scripts/migrate-puck-size-spacing.ts --dry-run",
    "puck:migrate-layout-blocks": "tsx --conditions=react-server scripts/migrate-puck-layout-blocks.ts",
    "puck:migrate-layout-blocks:dry-run": "tsx --conditions=react-server scripts/migrate-puck-layout-blocks.ts --dry-run",
    "postinstall": "prisma generate"
  },
