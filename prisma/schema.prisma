// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output        = "../generated/prisma"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
}

model Language {
  id   String  @id @default(uuid())
  code String  @unique
  name String
  slug String?

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id String @id @default(uuid())

  siteName         String?
  siteUrl          String?
  deployWebhookUrl String?

  logoUrl String?

  /// IANA time zone the site schedules in (e.g. "Europe/Rome"). Applied to
  /// cron triggers and to the Wait node's time-of-day anchoring.
  timezone String? @default("Europe/Rome")

  /// [Scripts]
  scripts Json @default("null") @db.JsonB

  seo   Seo?    @relation(fields: [seoId], references: [id])
  seoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum WidgetSection {
  HERO
  MODAL_POPUP
  POST_SIDEBAR
  POST_BOTTOM
}

enum WidgetType {
  SEARCH_BOX
  POST
  CATEGORY
  TAG
  PRODUCT
  NEWSLETTER
  AUTHOR
  SOCIAL
  PRODUCT_POP
  NEWSLETTER_POP
}

model Widget {
  id String @id @default(uuid())

  name    String
  section WidgetSection
  type    WidgetType
  sort    Int

  isEnabled Boolean @default(false)

  /// [WidgetMetadata]
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  USER
  EDITOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  users       User[]
  invitations Invitation[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(uuid())
  key       String           @unique
  area      String
  action    String
  roles     RolePermission[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model User {
  id String @id @default(uuid())

  name      String?
  firstName String?
  lastName  String?

  password String?

  email         String? @unique
  emailVerified Boolean @default(false)

  image String?

  profileImage   Media?  @relation(fields: [profileImageId], references: [id], onDelete: Cascade)
  profileImageId String?

  accounts Account[]
  sessions Session[]

  bio      String?
  imageUrl String?

  role UserRole @default(USER)

  accountStatus      AccountStatus            @default(ACTIVE)
  roleId             String?
  roleDefinition     Role?                    @relation(fields: [roleId], references: [id])
  invitationsCreated Invitation[]             @relation("InvitationCreator")
  activitiesAsActor  AdministrativeActivity[] @relation("ActivityActor")

  pageVersions PageVersion[]

  postVersions PostVersion[]
  categories   Category[]
  tags         Tag[]
  postAuthors  PostAuthor[]

  notifications Notification[]
  products      Product[]
  customer      Customer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdministrativeActivity {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  area       String
  targetType String
  targetId   String?
  outcome    String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

model Invitation {
  id         String           @id @default(uuid())
  email      String
  tokenHash  String           @unique
  expiresAt  DateTime
  status     InvitationStatus @default(PENDING)
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  role        Role   @relation(fields: [roleId], references: [id])
  roleId      String
  createdBy   User   @relation("InvitationCreator", fields: [createdById], references: [id])
  createdById String

  @@index([email, status])
  @@index([expiresAt, status])
}

model Account {
  id     String @id @default(cuid())
  userId String @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId             String
  providerId            String
  issuer                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  scope String?

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

enum MediaType {
  AUDIO
  FILE
  IMAGE
  VIDEO
}

model Media {
  id String @id @default(uuid())

  name    String
  key     String?
  url     String    @unique @db.Text
  size    Int?
  type    MediaType @default(FILE)
  altText String?

  postVersions PostVersion[]
  seo          Seo[]
  product      Product[]
  impression   Impression?
  products     ProductGallery[]
  user         User[]
  pageVersions PageVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ContentStatus {
  DRAFT
  CHANGED
  PUBLISHED
  SCHEDULED
}

model Seo {
  id String @id @default(uuid())

  title        String
  description  String?
  canonicalUrl String?

  version Int

  noIndex  Boolean @default(false)
  noFollow Boolean @default(false)

  ogTwitterType        String?
  ogTwitterTitle       String?
  ogTwitterDescription String?
  ogTwitterImage       Media?  @relation(fields: [ogTwitterImageId], references: [id])
  ogTwitterImageId     String?
  ogTwitterLocale      String?
  ogTwitterUrl         String?

  rootId       String?
  root         Seo?    @relation("RootChildren", fields: [rootId], references: [id])
  rootChildren Seo[]   @relation("RootChildren")

  settings Settings[]

  pageVersions PageVersion[]

  postVersions PostVersion[]
  categories   Category[]

  tags Tag[]

  products          Product[]
  productCategories ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PageEditorType {
  PUCK
}

/// Logical page identity. Owns the stable slug and the two special version
/// pointers (current draft + live version). See CONTEXT.md "Current version".
model PageRoot {
  id   String @id @default(uuid())
  slug String @unique

  firstPublishedAt DateTime?

  currentVersion   PageVersion? @relation("PageRootCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  currentVersionId String?      @unique

  liveVersion   PageVersion? @relation("PageRootLiveVersion", fields: [liveVersionId], references: [id], onDelete: SetNull)
  liveVersionId String?      @unique

  versions PageVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One revision of a Page. Owns the mutable content and a sequential version
/// number scoped to its root.
model PageVersion {
  id String @id @default(uuid())

  title String

  version Int

  status     ContentStatus  @default(DRAFT)
  editorType PageEditorType @default(PUCK)
  /// [PuckData]
  puckData   Json?          @db.JsonB

  root   PageRoot @relation(fields: [rootId], references: [id], onDelete: Cascade)
  rootId String

  seo   Seo?    @relation(fields: [seoId], references: [id], onDelete: SetNull)
  seoId String?

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  imageCover   Media?  @relation(fields: [imageCoverId], references: [id], onDelete: SetNull)
  imageCoverId String?

  publishedAt DateTime?
  scheduledAt DateTime?

  currentForRoot PageRoot? @relation("PageRootCurrentVersion")
  liveForRoot    PageRoot? @relation("PageRootLiveVersion")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rootId, version])
  @@index([rootId])
  @@index([status, scheduledAt])
}

/// Logical post identity. Owns the stable slug, the first publication date,
/// and the two special version pointers (current draft + live version).
/// See CONTEXT.md "Post".
model PostRoot {
  id   String @id @default(uuid())
  slug String @unique

  firstPublishedAt DateTime?

  currentVersion   PostVersion? @relation("PostRootCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  currentVersionId String?      @unique

  liveVersion   PostVersion? @relation("PostRootLiveVersion", fields: [liveVersionId], references: [id], onDelete: SetNull)
  liveVersionId String?      @unique

  versions PostVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One revision of a Post. Owns the mutable content and every editorial
/// relation (authors, taxonomy links, FAQs, SEO), so they draft and publish
/// atomically with the content.
model PostVersion {
  id String @id @default(uuid())

  title       String
  description String?

  version Int

  status ContentStatus @default(DRAFT)

  bodyData Json? @db.JsonB

  /// [TipTapBodyData]
  tiptapBodyData Json? @db.JsonB

  root   PostRoot @relation(fields: [rootId], references: [id], onDelete: Cascade)
  rootId String

  imageCover   Media?  @relation(fields: [imageCoverId], references: [id], onDelete: SetNull)
  imageCoverId String?

  categories PostCategory[]
  tags       Tag[]
  authors    PostAuthor[]

  faqs Faq[]

  seo   Seo?    @relation(fields: [seoId], references: [id], onDelete: SetNull)
  seoId String?

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  scheduledAt         DateTime?
  preSchedulingStatus ContentStatus?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  currentForRoot PostRoot? @relation("PostRootCurrentVersion")
  liveForRoot    PostRoot? @relation("PostRootLiveVersion")

  @@unique([rootId, version])
  @@index([rootId])
  @@index([status, scheduledAt])
}

model PostAuthor {
  post   PostVersion @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  sort Int

  @@id([postId, userId])
}

model Category {
  id String @id @default(uuid())

  title       String
  slug        String @unique
  description String?

  postCategories PostCategory[]

  seo   Seo?    @relation(fields: [seoId], references: [id])
  seoId String?

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostCategory {
  post   PostVersion @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  sort Int

  @@id([postId, categoryId])
}

model Tag {
  id String @id @default(uuid())

  title       String
  slug        String  @unique
  description String?

  postVersions PostVersion[]

  seo   Seo?    @relation(fields: [seoId], references: [id])
  seoId String?

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EmailProvider {
  SENDGRID
  RESEND
}

model EmailSetting {
  id String @id @default(uuid())

  emailSender     String?
  emailSenderName String?
  emailResponse   String?
  emailProvider   EmailProvider?
  emailApiKey     String?

  maxEmailsPerDay Int?

  subscriptionTemplate   EmailTemplate? @relation(name: "emailSetting1", fields: [subscriptionTemplateId], references: [id], onDelete: Cascade)
  subscriptionTemplateId String?

  freeEbookTemplate   EmailTemplate? @relation(name: "emailSetting2", fields: [freeEbookTemplateId], references: [id], onDelete: Cascade)
  freeEbookTemplateId String?

  webinarTemplate   EmailTemplate? @relation(name: "emailSetting3", fields: [webinarTemplateId], references: [id], onDelete: Cascade)
  webinarTemplateId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  id String @id @default(uuid())

  name        String
  description String?

  /// [EmailDesignData]
  designData Json?   @db.JsonB
  bodyHtml   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailSettingSubscription EmailSetting[] @relation(name: "emailSetting1")
  emailSettingFreeEbook    EmailSetting[] @relation(name: "emailSetting2")
  emailSettingWebinar      EmailSetting[] @relation(name: "emailSetting3")
}

enum AudienceType {
  GLOBAL
  LIST
}

model EmailAudience {
  id String @id @default(uuid())

  name        String
  type        AudienceType @default(LIST)
  description String?

  contacts EmailContact[]

  // emailSingleSend   EmailSingleSend? @relation(fields: [emailSingleSendId], references: [id])
  // emailSingleSendId String?
  emailSingleSends EmailSingleSend[]
  externalId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailContact {
  id String @id @default(uuid())

  firstName     String?
  lastName      String?
  email         String    @unique
  emailVerified DateTime?

  isSubscriber Boolean @default(true)
  externalId   String?

  audiences           EmailAudience[]
  interactions        EmailContactInteraction[]
  emailSingleSendLogs EmailSingleSendLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailContactInteraction {
  id String @id @default(uuid())

  interactionType String // es. 'newsletter_subscription', 'first_feedback_request', 'ebook_download'
  interactionDate DateTime @default(now())

  contact   EmailContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId, interactionType])
}

model EmailSingleSend {
  id String @id @default(uuid())

  name        String
  subject     String?
  previewText String?

  /// [EmailDesignData]
  designData Json?   @db.JsonB
  bodyHtml   String?

  audiences           EmailAudience[]
  emailSingleSendLogs EmailSingleSendLog[]

  externalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailSubscriptionToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, token])
}

model EmailSendLog {
  id String @id @default(uuid())

  to      String
  from    String
  subject String?

  type String

  /// Opaque key used to make a send idempotent (e.g. one automation Step).
  /// Reusing the same key never sends twice; the unique constraint also guards
  /// against concurrent retries.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailSingleSendLog {
  id String @id @default(uuid())

  contact   EmailContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String

  singleSend   EmailSingleSend @relation(fields: [singleSendId], references: [id], onDelete: Cascade)
  singleSendId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId, singleSendId])
}

enum ProductType {
  EBOOK
  SERVICE
  AFFILIATE
  WEBINAR
}

enum ProductAcquisitionMode {
  FREE
  PAID
  FORM
  AFFILIATE
}

model Product {
  id    String @id @default(uuid())
  title String
  slug  String

  description       Json? @db.JsonB
  /// [TipTapBodyData]
  tiptapDescription Json? @db.JsonB

  type ProductType

  version Int

  status ContentStatus @default(DRAFT)

  isLatest Boolean @default(true)

  imageCover   Media?  @relation(fields: [imageCoverId], references: [id])
  imageCoverId String?

  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  categoryId String?

  acquisitionMode ProductAcquisitionMode @default(PAID)

  price           Float?
  discountedPrice Float?
  isFree          Boolean @default(false)

  /// [ProductMetadata]
  metadata Json?          @db.JsonB
  extras   ProductExtra[]

  formId String?
  form   Form?   @relation(fields: [formId], references: [id])

  rootId       String?
  root         Product?  @relation("RootChildren", fields: [rootId], references: [id])
  rootChildren Product[] @relation("RootChildren")

  gallery ProductGallery[]
  faqs    Faq[]
  reviews Reviews[]

  purchases  Purchase[]
  orderItems OrderItem[]

  seo   Seo?    @relation(fields: [seoId], references: [id])
  seoId String?

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  firstPublishedAt DateTime?
  publishedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductCategory {
  id String @id @default(uuid())

  title       String
  slug        String @unique
  description String?

  products Product[]

  seo   Seo?    @relation(fields: [seoId], references: [id])
  seoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductGallery {
  id   String @id @default(cuid())
  sort Int // Campo per l'ordinamento

  // Relazioni
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id])

  @@unique([productId, mediaId])
}

model ProductExtra {
  id String @id @default(uuid())

  name        String
  description String?
  price       Float
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id String @id @default(uuid())

  question String
  answer   String
  sort     Int

  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String?

  post   PostVersion? @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([postId])
}

model Reviews {
  id String @id @default(uuid())

  rating           Float
  role             String?
  comment          String?
  reviewerName     String?
  date             DateTime @default(now())
  verifiedPurchase Boolean  @default(false)

  status Boolean @default(false)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdCampaign {
  id String @id @default(uuid())

  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(false)

  blocks AdBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdBlock {
  id String @id @default(uuid())

  label      String
  layoutType AdLayoutType
  isActive   Boolean      @default(true)

  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  items AdItem[]

  placement      AdPositionPlacement @default(BEFORE)
  reference      AdPositionReference @default(HEADING)
  referenceCount Int                 @default(0)

  minWords Int @default(0)

  excludedPostIds     String[] @default([])
  excludedCategoryIds String[] @default([])
  excludedTagIds      String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdItem {
  id String @id @default(uuid())

  sourceType AdItemSourceType
  adBlockId  String
  adBlock    AdBlock          @relation(fields: [adBlockId], references: [id], onDelete: Cascade)

  // statics data
  title       String?
  description String?
  imageUrl    String?
  url         String?

  // dynamic relations
  postRootId    String?
  productRootId String?

  sort     Int?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AdLayoutType {
  SINGLE
  GRID
  CAROUSEL
}

enum AdItemSourceType {
  STATIC // Dati scritti direttamente nell’AdItem
  POST // Collegato a un post del blog
  PRODUCT // Collegato a un prodotto
}

enum AdPositionPlacement {
  BEFORE
  AFTER
}

enum AdPositionReference {
  HEADING
  HEADING_2
  HEADING_3
  HEADING_4
  PARAGRAPH
  IMAGE
}

model Purchase {
  id String @id @default(uuid())

  email String

  product       Product @relation(fields: [productId], references: [id])
  productId     String
  productRootId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactForm {
  id String @id @default(uuid())

  name    String?
  email   String?
  subject String?
  message String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Form {
  id String @id @default(uuid())

  name        String
  /// [FormFields]
  fields      Json?   @db.JsonB
  /// [FormContentState]
  content     Json?   @db.JsonB
  submitLabel String?

  gtmEventName String? // es: "form_submission_laboratorio"
  gtmCategory  String? // es: "lead" o "submission"
  gtmLabel     String? // es: "Laboratorio di scrittura novembre"

  products    Product[]
  submissions FormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormSubmission {
  id String @id @default(uuid())

  formId String
  form   Form   @relation(fields: [formId], references: [id])

  email String?
  /// [SubmissionData]
  data  Json    @db.JsonB // dati sottomessi dall’utente

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Format {
  id String @id @default(uuid())

  title      String
  Impression Impression[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Genre {
  id String @id @default(uuid())

  title      String
  Impression Impression[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Impression {
  id        String  @id @default(uuid())
  title     String
  firstName String?
  lastName  String?
  email     String
  pageCount Int?

  format   Format? @relation(fields: [formatId], references: [id])
  formatId String?

  genre   Genre?  @relation(fields: [genreId], references: [id])
  genreId String?

  file   Media?  @relation(fields: [fileId], references: [id])
  fileId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  type    String
  message String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SocialKey {
  FACEBOOK
  TWITTER
  INSTAGRAM
  LINKEDIN
  PINTEREST
  YOUTUBE
}

enum SocialEntityType {
  SITE
  USER
}

model SocialChannel {
  id String @id @default(uuid())

  key SocialKey
  url String?

  entityId   String
  entityType SocialEntityType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, entityId, entityType])
}

enum ScheduledActionType {
  PUBLISH_POST
  SEND_EMAIL
}

enum ScheduledActionStatus {
  SCHEDULED
  PROCESSING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCELED
}

model ScheduledAction {
  id String @id @default(uuid())

  type       ScheduledActionType
  targetType String
  targetId   String

  /// Absolute instant at which the action should execute.
  plannedAt DateTime

  /// IANA timezone identifier captured from the browser when scheduling.
  timezone String

  status ScheduledActionStatus @default(SCHEDULED)

  /// True while the action is eligible for execution. Terminal states flip
  /// this to false so a target can have a durable history and still accept a
  /// new active action later (e.g. a reusable EmailSingleSend).
  active Boolean @default(true)

  /// Number of execution attempts already performed.
  attempts Int @default(0)

  /// Maximum number of attempts before the action is marked FAILED.
  maxAttempts Int @default(3)

  /// When the action should become eligible for the next retry.
  retryAt DateTime?

  /// Opaque identifier of the current worker claim/lease.
  leaseId String?

  /// Lease expiration time; an expired lease makes the action recoverable.
  leaseExpiresAt DateTime?

  /// Stable idempotency key reused across retries for the same action.
  idempotencyKey String

  /// Provider-side identifier when applicable (e.g. email provider send id).
  providerId String?

  /// Human-readable failure reason from the last attempt.
  lastError String?

  /// Actual execution time.
  executedAt DateTime?

  canceledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, plannedAt, retryAt])
  @@index([targetType, targetId, status])
  @@index([leaseExpiresAt, status])
  @@index([active])
}

enum AutomationStatus {
  DRAFT
  PUBLISHED
}

/// Authored, versioned workflow blueprint in the CMS (see CONTEXT.md "Automation engine").
model Automation {
  id   String @id @default(uuid())
  name String

  status AutomationStatus @default(DRAFT)

  /// Frozen graph captured at publish time; Runs execute this, never the live draft (ADR-0004).
  publishedSnapshot Json? @db.JsonB

  /// Hash of the webhook trigger secret; the raw secret is never stored.
  webhookSecretHash String?

  nodes       Node[]
  connections Connection[]
  runs        AutomationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Authored element of an Automation: a Trigger or an Action.
model Node {
  id   String  @id @default(uuid())
  type String
  name String?

  /// Canvas position, e.g. { x, y }.
  position Json @db.JsonB

  /// Node configuration; may contain template expressions. Never holds secret material.
  data Json @default("{}") @db.JsonB

  credential   Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  credentialId String?

  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String

  fromConnections Connection[] @relation("ConnectionFromNode")
  toConnections   Connection[] @relation("ConnectionToNode")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([automationId])
  @@index([credentialId])
}

/// Directed link between two Nodes carrying the source output to the target input.
model Connection {
  id String @id @default(uuid())

  /// Output port of the source Node: "main" by default; the Conditional node uses "true"/"false".
  fromOutput String @default("main")

  /// Input port of the target Node.
  toInput String @default("main")

  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String

  fromNode   Node   @relation("ConnectionFromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  fromNodeId String

  toNode   Node   @relation("ConnectionToNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  toNodeId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A duplicate identical edge would double the token arrival (one Step per
  /// arriving token), so identical fan-out edges are rejected at the DB.
  @@unique([fromNodeId, toNodeId, fromOutput, toInput])
  @@index([automationId])
  @@index([toNodeId])
}

enum AutomationRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

/// A single execution of an Automation, created when its trigger fires.
model AutomationRun {
  id          String              @id @default(uuid())
  triggerType String
  status      AutomationRunStatus @default(RUNNING)

  /// The published snapshot captured at trigger time, so later republishes
  /// cannot mutate a live run (ADR-0004).
  graph Json @db.JsonB

  /// Trigger input snapshot (e.g. form payload). Absent for triggers with no input.
  payload Json? @db.JsonB

  /// Opaque dedup key chosen by the caller (ADR-0005); the engine never interprets it.
  /// Dedup is engine-time: enqueueRun skips when a non-terminal Run with the same
  /// (automationId, idempotencyKey) exists (spec.md). Null keys may repeat
  /// (cron/manual triggers).
  idempotencyKey String?

  /// Human-readable failure reason for FAILED runs.
  error String?

  /// Human-readable cancellation reason for CANCELED runs (ADR-0010).
  cancelReason String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String

  steps AutomationRunStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([automationId, idempotencyKey])
  @@index([status, startedAt])
}

enum AutomationRunStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

/// Run-time ledger of one Node execution inside a Run (see CONTEXT.md "Step").
model AutomationRunStep {
  id String @id @default(uuid())

  /// Authored Node id this Step records. No FK on purpose: Runs execute a frozen
  /// snapshot, so editing the draft must never block execution history.
  nodeId String

  /// Order of execution within the Run.
  seq Int

  /// Token received along a Connection (one Step per arriving token).
  input  Json? @db.JsonB
  output Json? @db.JsonB

  status   AutomationRunStepStatus @default(PENDING)
  attempts Int                     @default(0)

  leaseId        String?
  leaseExpiresAt DateTime?

  /// When a waiting Step becomes due again; a Run "sleeps" as rows (ADR-0003).
  resumeAt DateTime?

  /// Human-readable failure reason from the last attempt.
  error String?

  startedAt DateTime?
  endedAt   DateTime?

  run   AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, seq])
  @@index([runId, nodeId])
  @@index([status, resumeAt])
  @@index([status, leaseExpiresAt, resumeAt])
}

/// Stored, encrypted secret that Nodes reference by id (see CONTEXT.md "Credential").
model Credential {
  id   String @id @default(uuid())
  name String
  type String

  /// The secret encrypted at rest (AES, key from environment); plaintext never
  /// leaves the encryption boundary and never lands in Node data or snapshots.
  secretEncrypted String

  nodes Node[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  DRAFT
  PENDING
  COMPLETED
  CANCELLED
}

enum OrderSource {
  MANUAL
  FORM_SUBMISSION
  AUTOMATION
  STRIPE
}

enum PaymentMethod {
  OFFLINE
  STRIPE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

/// Commercial buyer (see CONTEXT.md "Customer"), distinct from User and EmailContact.
model Customer {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String?
  phone       String?
  billingInfo Json?
  notes       String?
  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id])
  orders      Order[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Commercial request by a Customer to buy products or services (see CONTEXT.md "Order").
model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  status      OrderStatus @default(DRAFT)
  source      OrderSource @default(MANUAL)
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  payments    Payment[]
  totalAmount Float
  currency    String      @default("EUR")
  /// Business date of the sale. Defaults to creation time but can be set by an
  /// admin so imported/historical orders keep their real date. Drives the year
  /// segment of `orderNumber`.
  orderDate   DateTime    @default(now())
  notes       String?
  completedAt DateTime?
  completedBy String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

/// A single line inside an Order with a price/name snapshot (see CONTEXT.md "Order item").
model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  nameSnapshot String
  unitPrice    Float
  quantity     Int      @default(1)
  totalPrice   Float
  metadata     Json?
  createdAt    DateTime @default(now())
}

/// Record of money received or expected for an Order (see CONTEXT.md "Payment").
model Payment {
  id        String        @id @default(uuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    PaymentMethod @default(OFFLINE)
  status    PaymentStatus @default(PENDING)
  amount    Float
  currency  String        @default("EUR")
  reference String?
  paidAt    DateTime?
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
